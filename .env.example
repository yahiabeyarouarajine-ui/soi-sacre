# Copy to .env and fill in. NEVER commit .env.
# Providers are tried in order. Use "mock" to run without any API key.
LLM_PROVIDERS=gemini,groq

# Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

RATE_LIMIT_PER_MIN=10
CORS_ORIGINS=*

# Verified local helpline text shown on the care message (fill with a real, checked resource)
HELPLINE_TEXT=
